# Server
HOST=0.0.0.0
PORT=8000
FLASK_ENV=production

# Database.
# Default: local SQLite file stored under ./data
# Production: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///data/email_validator.db

# Upload/request limits
MAX_CONTENT_LENGTH=25165824
MAX_EMAILS_PER_JOB=100000

# Batch engine
JOB_BATCH_SIZE=200
WORKER_CONCURRENCY=8
DNS_TIMEOUT=3
RATE_LIMIT_DELAY=0.15
WORKER_RATE_LIMIT_PER_SECOND=60

# CORS - only needed when frontend is served from another origin.
# Use comma separated origins.
CORS_ORIGINS=*

# Optional DeepSeek AI analysis. The app works without it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Catch-all probing is DISABLED by default.
# We do not perform mailbox login or send test emails. This must remain false
# unless you provide a verified, consent-based catch-all domain list.
ENABLE_CATCHALL_PROBE=false
